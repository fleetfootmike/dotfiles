#!/usr/bin/env bash

CARTON=""
# this may potentially set $PERL5LIB and $CARTON
# shellcheck source=/dev/null  # .perlenv is per-repo and not present to follow
if [ -e .perlenv ]
then
  .  .perlenv
elif [ -e ~/.perlenv ]
then
    # shellcheck source=/dev/null  # ~/.perlenv path is non-constant to follow
    . ~/.perlenv
fi

# override prompts need the tty; probe it so a missing terminal (CI, an
# agent, a scripted commit) neither errors here nor hangs the prompts later.
INTERACTIVE=0
# shellcheck disable=SC2217  # opening /dev/tty is the probe; true is a no-op
if { true < /dev/tty; } 2>/dev/null
then
    exec < /dev/tty
    INTERACTIVE=1
fi

RED='\033[0;31m'
BLUE='\033[0;34m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

function typeof () {
    filename=$1

    # add new filetypes here

    case $(basename "$filename") in
        *.pl | *.pm ) echo perl; exit ;;
        *.json ) echo json; exit ;;
        *.tmpl | *.tt ) echo template; exit ;;
        *.t ) echo test; exit ;;
        *.sh ) echo bash; exit ;; # probably, anyway :D
        *.yml | *.yaml ) echo yaml; exit;;
        *.md ) echo md; exit;;
        *.sql ) echo sql; exit;;
        # *.js ) echo javascript; exit;;
        Dockerfile*) echo dockerfile; exit;;
    esac

    # for files with no extension, lets look at the shbang line
    shbang=$(head -1 "$1")
    case $shbang in
        '#!'*perl )
            echo perl; exit ;;
        '#!'*bash )
            echo bash; exit ;;
    esac

    echo "unhandled";
}

# Ask whether to commit a file a linter flagged, or fail closed when there is
# no terminal to ask on. $1 is a human description, e.g. "YAML file".
function prompt_override () {
    if [ "$INTERACTIVE" != 1 ]
    then
        echo -e "${RED}???${NC} pre-commit: non-interactive, can't ask about this $1; treating as failure"
        return 1
    fi
    while true; do
        echo -e -n "${RED}???${NC} pre-commit: Do you wish to commit this $1 anyway? "; read yn
        case $yn in
            [Yy]* ) return 0 ;;
            [Nn]* ) return 1 ;;
            * ) echo -e "${RED}???${NC} pre-commit: Please answer yes or no.";;
        esac
    done
}

function validate_yaml () {
    # requires yamllint
    filename=$1
    if yamllint "$filename"
    then
        return 0
    fi
    # some Ansible and Git YAML has decidedly iffy formatting
    prompt_override "YAML file"
}

function validate_sql () {
    echo -e "${BLUE}###${NC} pre-commit: Can't validate SQL yet!"
    return 0
}

function validate_bash () {
    filename=$1
    if ! command -v shellcheck >/dev/null 2>&1
    then
        echo -e "${BLUE}###${NC} pre-commit: shellcheck not found, falling back to bash -n"
        bash -n "$filename"
        return $?
    fi
    if shellcheck -S warning "$filename"
    then
        return 0
    fi
    # a finding at warning level or above; ask, or fail closed if headless
    prompt_override "shell file"
}

branch="$(git rev-parse --abbrev-ref HEAD)"

if [ "$branch" = "master" ] || [ "$branch" = "main" ]; then
    echo -e "${RED}!!!${NC} pre-commit: ${RED}###${NC} Aborting commit. You can't commit directly to $branch branch. ${RED}###${NC}"
    exit 1
fi

if git rev-parse --verify HEAD >/dev/null 2>&1
then
	against=HEAD
else
	# Initial commit: diff against an empty tree object
	against=$(git hash-object -t tree /dev/null)
fi

badFiles=""

# Read the staged file list NUL-delimited (-z) so paths with spaces, globs or
# newlines survive intact, and feed it via process substitution rather than a
# pipe: a pipe would run this loop in a subshell where badFiles could not
# escape. bad files are collected newline-separated for the same reason.
while IFS= read -r -d '' file
do
    # skip files staged for deletion — there is nothing on disk to lint
    if [ -n "$(git diff --cached --name-only --diff-filter=D "$against" -- "$file")" ]
    then
        echo -e "${BLUE}>>>${NC} pre-commit: skipping deleted file $file"; continue
    fi

    type=$(typeof "$file")
    if [ "unhandled" = "$type" ]
    then
        echo -e "${BLUE}>>>${NC} pre-commit: skipping unhandled file $file"; continue
    fi

    echo -e "${BLUE}>>>${NC} pre-commit: checking $type file $file"
    BAD=false
    case $type in
        # file type detected in function typeof above
        test )
            # we could fall through and syntax check the Perl, but trying to run it
            # will essentially do that anyway :D
            $CARTON prove -l "$file" || BAD=true
            ;;
        perl )
            $CARTON perl -Ilib -cw "$file" || BAD=true
            ;;
        json )
            json_pp -t null < "$file" && echo "JSON syntax OK" || BAD=true
            ;;
        bash )
            # lint with shellcheck (quoting, unset vars, etc.) when available,
            # otherwise a bare bash -n syntax check
            validate_bash "$file" && echo "Bash syntax OK" || BAD=true
            ;;
        yaml )
            # note this is a bit picky, so it will prompt you as to whether you
            # are happy or not.
            validate_yaml "$file" && echo "YAML syntax OK" || BAD=true
            ;;
        md )
            markdownlint "$file" || BAD=true
            ;;
        sql )
            validate_sql "$file" && echo "SQL syntax presumed OK" || BAD=true
            ;;
        dockerfile )
            docker build --check -f "$file" . || BAD=true
            ;;
        * )
            echo "detected but unhandled file type $type: assume OK"
            ;;
    esac

    if $BAD
    then
        badFiles="${badFiles}${file}"$'\n'
    fi
done < <(git diff --cached --name-only -z "$against")

if [ -z "$badFiles" ]
then
    echo -e "${GREEN}+++${NC} pre-commit: all files OK"
    exit 0;
else
    echo
    echo -e "${RED}!!!${NC} pre-commit: ${RED}###${NC} Aborting commit.  Failed checks: ${RED}###${NC}"
    while IFS= read -r file
    do
        [ -n "$file" ] && echo "    $file"
    done <<< "$badFiles"
    echo
    echo -e "${RED}!!!${NC} pre-commit: If you are ${RED}ABSOLUTELY${NC} 100% sure that you can skip these pre-commit tests, add:";
    echo "       --no-verify";
    echo -e "to your last command to skip them, and ${BLUE}indicate clearly${NC} you have done so in the PR.";
    exit 1;
fi
